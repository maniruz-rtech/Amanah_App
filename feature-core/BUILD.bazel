load("@rules_kotlin//kotlin:android.bzl", "kt_android_library", "kt_android_local_test")

kt_android_library(
    name = "feature-core",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    custom_package = "com.amanah.feature.core",
    manifest = "src/main/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
    plugins = ["//:nullaway_plugin", "//:compose_plugin"],
    deps = [
        "//libraries/nodes-framework",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",

        # Compose
        "@maven//:androidx_activity_activity_compose",
        "@maven//:androidx_compose_ui_ui",
        "@maven//:androidx_compose_ui_ui_tooling_preview",
        "@maven//:androidx_compose_foundation_foundation",
        "@maven//:androidx_compose_material3_material3",
        "@maven//:androidx_compose_material_material_icons_extended",
        "@maven//:androidx_compose_animation_animation",
        "@maven//:androidx_compose_runtime_runtime",
        "@maven//:androidx_lifecycle_lifecycle_runtime_compose",

        # MVI
        "@maven//:com_github_badoo_MVICore_mvicore",
        "@maven//:com_github_badoo_MVICore_mvicore_android",

        # Reaktive
        "@maven//:com_badoo_reaktive_reaktive_jvm",
        "@maven//:com_badoo_reaktive_reaktive_annotations_jvm",

        # Memory safety
        "@maven//:com_badoo_mobile_android_weak_handler",

        # Networking
        "@maven//:com_squareup_okhttp3_okhttp",
        "@maven//:com_squareup_okhttp3_logging_interceptor",
        "@maven//:com_squareup_retrofit2_retrofit",
        "@maven//:com_squareup_retrofit2_converter_gson",
        "@maven//:com_google_code_gson_gson",

        # Secure storage (Tink + DataStore)
        "@maven//:com_google_crypto_tink_tink_android",
        "@maven//:androidx_datastore_datastore_preferences_android",
        "@maven//:androidx_datastore_datastore_preferences_core",
        "@maven//:androidx_datastore_datastore_core",
        "@maven//:androidx_datastore_datastore",

        # Lifecycle (for AppForegroundObserver)
        "@maven//:androidx_lifecycle_lifecycle_process",
        "@maven//:androidx_lifecycle_lifecycle_runtime_ktx",
        "@maven//:androidx_lifecycle_lifecycle_common",

        # Geo (FusedLocationProvider + H3 indexing)
        "//libraries/location",
        "@maven//:com_google_android_gms_play_services_location",

        # FCM (push wakeup + emergency notifications)
        "@maven//:com_google_firebase_firebase_messaging",
        "@maven//:com_google_firebase_firebase_common",
    ],
    visibility = ["//visibility:public"],
)

# ── Unit tests (JVM, no Robolectric) — one target per test class ─────────────
# (test class name, package under com.amanah.feature.core)
[
    kt_android_local_test(
        name = t[0],
        srcs = ["src/test/kotlin/com/amanah/feature/core/%s/%s.kt" % (t[1], t[0])],
        manifest = "src/test/AndroidManifest.xml",
        custom_package = "com.amanah.feature.core.test",
        test_class = "com.amanah.feature.core.%s.%s" % (t[1], t[0]),
        associates = [":feature-core"],
        deps = [
            "@maven//:junit_junit",
            "@maven//:io_mockk_mockk_jvm",
            "@maven//:org_jetbrains_kotlin_kotlin_test",
            "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test",
            "@maven//:com_badoo_reaktive_reaktive_jvm",
            "@maven//:com_google_code_gson_gson",
        ],
    )
    for t in [
        ("EventDedupTest", "realtime"),
        ("InMemoryOutboundQueueTest", "realtime"),
        ("ReconnectStrategyTest", "realtime"),
        ("DeviceIdentityTest", "session"),
        ("LoginRequestTest", "network"),
    ]
]

# Live contract test — opt-in: `manual` keeps it out of `bazel test //...`; see the
# class doc for how to run it against a local backend.
kt_android_local_test(
    name = "LoginContractLiveTest",
    srcs = ["src/test/kotlin/com/amanah/feature/core/network/LoginContractLiveTest.kt"],
    manifest = "src/test/AndroidManifest.xml",
    custom_package = "com.amanah.feature.core.test",
    test_class = "com.amanah.feature.core.network.LoginContractLiveTest",
    associates = [":feature-core"],
    tags = ["manual", "requires-network"],
    deps = [
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlin_kotlin_test",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "@maven//:com_google_code_gson_gson",
    ],
)
