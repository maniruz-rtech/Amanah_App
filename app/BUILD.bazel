load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_android//android:rules.bzl", "android_binary")

kt_android_library(
    name = "app_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    custom_package = "com.amanah.app",
    manifest = "src/main/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
    plugins = ["//:nullaway_plugin", "//:compose_plugin"],
    deps = [
        "//libraries/nodes-framework",
        "//libraries/location",
        "//feature-core",
        "//feature-auth",
        "//feature-admin",
        "//feature-user",
        "//feature-emergency",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:androidx_activity_activity_compose",
        "@maven//:androidx_core_core_ktx",
        "@maven//:androidx_startup_startup_runtime",
        "@maven//:androidx_compose_ui_ui",
        "@maven//:androidx_compose_runtime_runtime",
        "@maven//:com_badoo_mobile_android_weak_handler",
    ],
)

android_binary(
    name = "amanah",
    custom_package = "com.amanah.app",
    manifest = "src/main/AndroidManifest.xml",
    manifest_values = {
        "applicationId":    "com.amanah.app",
        "minSdkVersion":    "26",
        "targetSdkVersion": "36",
        "versionCode":      "2",
        "versionName":      "2.0.0",
        # Dummy Maps key — replace via release manifest_values override
        # (or a build-time `--define MAPS_API_KEY=...`) before shipping.
        # Without a real key, MapView fails silently with "API key missing"
        # at runtime; build succeeds.
        "MAPS_API_KEY":     "AIzaSy-MISSING-KEY-PLACEHOLDER-FOR-BUILD",
    },
    deps      = [":app_lib"],

    # R8 / ProGuard rules applied in release builds. The companion rules file
    # carries reasoning comments per stanza (Gson, Retrofit, OkHttp, Reaktive,
    # MVICore, Tink, Compose, Nodes framework).
    proguard_specs = ["proguard-rules.pro"],

    visibility = ["//visibility:public"],
)

