# Amanah Backend Environment Variables
# Copy this file to .env and fill in the values

# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://amanah:amanah_dev_password@localhost:5432/amanah
POSTGRES_USER=amanah
POSTGRES_PASSWORD=amanah_dev_password
POSTGRES_DB=amanah

# Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Field Encryption (32 bytes for AES-256)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Incident Settings
RESPONDER_SEARCH_RADIUS_KM=10.0
INCIDENT_ESCALATION_TIMEOUT_SECONDS=300
INCIDENT_LOCATION_EXPIRY_DAYS=90
BROADCAST_RESPONDER_LIMIT=25

# Twilio (SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Firebase (Push Notifications)
# FIREBASE_CREDENTIALS_PATH=

# Email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
